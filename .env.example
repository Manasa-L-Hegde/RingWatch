# Hostname or IP address for the FalkorDB instance (e.g. localhost or cloud URI)
FALKORDB_HOST=

# Port number for the FalkorDB service (e.g. 6379)
FALKORDB_PORT=

# Optional username for authenticated FalkorDB instances
FALKORDB_USERNAME=

# Optional password for authenticated FalkorDB or FalkorDB Cloud instances
FALKORDB_PASSWORD=

# Enable SSL/TLS encryption (set to true for FalkorDB Cloud connections)
FALKORDB_SSL=

# Google Gemini API key for function-calling tool selection and explanation (runs in template mode if empty)
GEMINI_API_KEY=

# Overridable Gemini model identifier (e.g. gemini-flash-lite-latest)
GEMINI_MODEL=

# Enable public demo guardrails, global hourly rate limits, and visitor analyst isolation (true/false)
PUBLIC_DEMO=

# Maximum number of analyst memory graphs allowed before cap warning is triggered (e.g. 200)
MAX_MEMORY_GRAPHS=
